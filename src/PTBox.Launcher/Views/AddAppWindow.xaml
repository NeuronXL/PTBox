<Window x:Class="PTBox.Launcher.Views.AddAppWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加应用" Width="660" Height="700" WindowStartupLocation="CenterOwner" PreviewKeyDown="OnKeyDown">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DialogStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Style><StaticResource ResourceKey="DialogWindow"/></Window.Style>
  <Viewbox><ContentControl Width="660" Height="700" Style="{StaticResource DialogFrame}"><StackPanel>
    <TextBlock Text="添加应用" FontSize="34" FontWeight="SemiBold" Margin="4,0,0,10"/>
    <TextBlock Text="选择常用模板，或添加你自己的应用。" Foreground="#A6B8CA" FontSize="18" Margin="4,0,0,24"/>
    <Button x:Name="SteamButton" Tag="steam" Click="ChooseTemplate" Height="94"><StackPanel><TextBlock Text="Steam" FontSize="24"/><TextBlock x:Name="SteamStatus" FontSize="15" Foreground="#BBCBDB" Margin="0,5,0,0"/></StackPanel></Button>
    <Button x:Name="MoonlightButton" Tag="moonlight" Click="ChooseTemplate" Height="94"><StackPanel><TextBlock Text="Moonlight" FontSize="24"/><TextBlock x:Name="MoonlightStatus" FontSize="15" Foreground="#BBCBDB" Margin="0,5,0,0"/></StackPanel></Button>
    <Button x:Name="LocalButton" Click="ChooseLocal" Height="82" Content="＋  本地程序" Margin="4,20,4,4"/>
    <Button x:Name="WebsiteButton" Click="ChooseWebsite" Height="82" Content="＋  网页链接"/>
    <TextBlock Text="模板只提供启动配置，不会下载或安装软件。" FontSize="15" Foreground="#A6B8CA" Margin="6,18,0,18"/>
    <Grid><ContentControl Style="{StaticResource DialogHint}" VerticalAlignment="Center"/><Button x:Name="CancelButton" Click="Cancel" Content="返回" Width="160" HorizontalAlignment="Right"/></Grid>
  </StackPanel></ContentControl></Viewbox>
</Window>
