<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="SettingsButton" TargetType="Button">
    <Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="#F4F7FB"/>
    <Setter Property="Background" Value="#99263546"/><Setter Property="BorderBrush" Value="#305B7084"/><Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="22,12"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="52"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="26" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A8FFFFFF"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/><Setter TargetName="Frame" Property="Background" Value="#4B6076"/><Setter Property="Foreground" Value="White"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}"/>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}"><Setter Property="Foreground" Value="#121C28"/><Setter Property="Background" Value="#F5F7FB"/><Setter Property="BorderBrush" Value="#F5F7FB"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SettingsTab" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Width" Value="188"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Style.Triggers>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsUpdatePage}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="updates"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#F4F7FB"/><Setter Property="Foreground" Value="#111B26"/></MultiDataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAppsPage}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="apps"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#F4F7FB"/><Setter Property="Foreground" Value="#111B26"/></MultiDataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSystemPage}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="system"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#F4F7FB"/><Setter Property="Foreground" Value="#111B26"/></MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="CaretBrush" Value="White"/>
    <Setter Property="Background" Value="#B51A2A3B"/><Setter Property="BorderBrush" Value="#395B7085"/><Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,8,0,18"/><Setter Property="MinHeight" Value="54"/><Setter Property="SelectionBrush" Value="#577EAA"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Frame" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/><Setter TargetName="Frame" Property="Background" Value="#D932465B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Padding" Value="16,12"/><Setter Property="FontSize" Value="20"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#30445A"/></Trigger>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#4B627B"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="FontSize" Value="20"/><Setter Property="MinHeight" Value="54"/><Setter Property="Margin" Value="0,8,0,18"/>
    <Setter Property="Background" Value="#B51A2A3B"/><Setter Property="BorderBrush" Value="#395B7085"/><Setter Property="BorderThickness" Value="2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Border x:Name="Frame" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="16,10,45,10" VerticalAlignment="Center"/>
        <Path Data="M0,0 L6,6 L12,0" Stroke="#EAF0F7" StrokeThickness="1.8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border Background="#FA142333" BorderBrush="#557187" BorderThickness="1" CornerRadius="14" Padding="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0">
            <ScrollViewer MaxHeight="320" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/><Setter TargetName="Frame" Property="Background" Value="#D932465B"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A8FFFFFF"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="FontSize" Value="21"/><Setter Property="Padding" Value="0,14"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="Frame" CornerRadius="14" BorderBrush="Transparent" BorderThickness="2" Padding="14,12" Background="Transparent"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" Margin="0,0,18,0"/>
        <Border x:Name="Track" Grid.Column="1" Width="58" Height="32" CornerRadius="16" Background="#455364" HorizontalAlignment="Right"><Ellipse x:Name="Knob" Width="24" Height="24" Fill="#BCC7D2" HorizontalAlignment="Left" Margin="4"/></Border>
      </Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#F2F6FC"/><Setter TargetName="Knob" Property="Fill" Value="#233B53"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/><Setter TargetName="Frame" Property="Background" Value="#303D546B"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#303D546B"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AppListItem" TargetType="ListBoxItem">
    <Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="10"/><Setter Property="Foreground" Value="#F3F6FB"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Frame" BorderBrush="Transparent" BorderThickness="2" CornerRadius="16" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#AA34495E"/><Setter TargetName="Frame" Property="BorderBrush" Value="#557F95AA"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#773A4D62"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/><Setter Property="Margin" Value="5,0,0,0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#667F94A7" CornerRadius="4" Margin="4,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
