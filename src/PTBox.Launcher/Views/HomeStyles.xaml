<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="HomeButton" TargetType="Button">
    <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FontSize" Value="20"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="3"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A0FFFFFF"/></Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/><Setter TargetName="Frame" Property="Background" Value="#425A6D"/><Setter Property="Foreground" Value="White"/></DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource HomeButton}">
    <Setter Property="Width" Value="94"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/>
    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#0F1823"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource HomeButton}">
    <Setter Property="Height" Value="58"/><Setter Property="Padding" Value="28,8"/><Setter Property="Margin" Value="0,0,16,0"/>
    <Setter Property="Background" Value="#99293643"/><Setter Property="BorderBrush" Value="#305D7286"/>
    <Style.Triggers><DataTrigger Binding="{Binding Id}" Value="$hero-launch"><Setter Property="Foreground" Value="#111923"/><Setter Property="Background" Value="#FAFCFF"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="PageDot" TargetType="Button" BasedOn="{StaticResource HomeButton}">
    <Setter Property="Width" Value="25"/><Setter Property="Height" Value="25"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="13" Background="Transparent" Padding="5"><Ellipse x:Name="Dot" Fill="#56636F"/></Border>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="White"/></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="White"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#B0FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ArtCard" TargetType="Button" BasedOn="{StaticResource HomeButton}">
    <Setter Property="Width" Value="198"/><Setter Property="Height" Value="160"/><Setter Property="Margin" Value="7,10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="FocusFrame" CornerRadius="18" BorderThickness="3" BorderBrush="Transparent" Background="Transparent" Padding="3" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Border CornerRadius="13" Background="{Binding Artwork}" BorderBrush="#26FFFFFF" BorderThickness="1">
          <Border CornerRadius="12">
            <Border.Background><SolidColorBrush Color="Transparent"/></Border.Background>
            <Grid Margin="12,16,12,12">
              <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="52" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,21" Visibility="Collapsed"/>
              <Image Source="{Binding DisplayIcon}" Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,0,21" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>
        </Border>
      </Border>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding DisplayIcon}" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="#A0FFFFFF"/></Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="FocusFrame" Property="BorderBrush" Value="White"/>
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:0.14"/>
            <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:0.14"/>
          </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
            <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
          </Storyboard></BeginStoryboard></DataTrigger.ExitActions>
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuickCard" TargetType="Button" BasedOn="{StaticResource HomeButton}">
    <Setter Property="Margin" Value="6,3"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" CornerRadius="16" BorderThickness="3" BorderBrush="Transparent" Padding="2">
        <Border Background="{Binding Artwork}" CornerRadius="12">
          <Border CornerRadius="12" Background="Transparent">
            <Grid Margin="24,10"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Image Source="{Binding DisplayIcon}" Width="40" Height="40" HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="38" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DisplayIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="17" Foreground="#CFD9E5" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
          </Border>
        </Border>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A0FFFFFF"/></Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
