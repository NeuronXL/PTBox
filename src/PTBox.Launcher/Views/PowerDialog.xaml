<Window x:Class="PTBox.Launcher.Views.PowerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PTBox · 确认" Width="800" Height="410" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False" PreviewKeyDown="OnKeyDown">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DialogStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Style><StaticResource ResourceKey="DialogWindow"/></Window.Style>
  <Viewbox><ContentControl Width="800" Height="410" Style="{StaticResource DialogFrame}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <TextBlock x:Name="Heading" Style="{StaticResource DialogHeading}"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18" Focusable="False"><TextBlock x:Name="Description" Style="{StaticResource DialogDescription}"/></ScrollViewer>
      <UniformGrid Grid.Row="2" Columns="2"><Button x:Name="CancelButton" Content="取消 / 返回" Click="CancelClick" Style="{StaticResource PrimaryButton}"/><Button x:Name="ConfirmButton" Content="确认" Click="ConfirmClick"/></UniformGrid>
      <ContentControl Grid.Row="3" Style="{StaticResource DialogHint}" VerticalAlignment="Bottom"/>
    </Grid>
  </ContentControl></Viewbox>
</Window>
