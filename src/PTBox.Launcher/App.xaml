<Application x:Class="PTBox.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Views/SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <!-- Four separate outlined pads, matching the concept art instead of a font-dependent symbol. -->
    <DrawingImage x:Key="DPadIcon">
      <DrawingImage.Drawing><DrawingGroup>
        <GeometryDrawing Geometry="M12,11 L12,6 C12,0 20,0 20,6 L20,11 Z M21,12 L26,12 C32,12 32,20 26,20 L21,20 Z M12,21 L20,21 L20,26 C20,32 12,32 12,26 Z M11,12 L11,20 L6,20 C0,20 0,12 6,12 Z">
          <GeometryDrawing.Pen><Pen Brush="#EEF2F7" Thickness="1.5" LineJoin="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#EEF2F7" Geometry="M15,15 L17,15 L17,17 L15,17 Z"/>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 L32,0 L32,32 L0,32 Z"/>
      </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F5F0"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B8C3"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#FFFFFF"/>
    <Style TargetType="Window">
      <Setter Property="Icon" Value="/PTBox.Launcher;component/Assets/Brand/ptbox.ico"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#101B24"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
  </ResourceDictionary></Application.Resources>
</Application>
